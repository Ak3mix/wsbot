# Copia este archivo como .env y descomenta/edita lo que necesites.
# Si no defines nada, se usan los defaults del bot.

# DEBUG=true/false
# DEBUG_MODE=true

# CSV de usuarios autorizados (vacío = todos)
# ALLOWED_USERS=521234567890,521234567891@c.us,2839174721783@lid

# CSV de grupos autorizados (vacío = todos)
# ALLOWED_GROUPS=120363427961804581@g.us

# CSV de palabras clave
# KEYWORDS=aeropuerto,terminal 1,terminal 2,terminal 3

# CSV de respuestas variadas
# AUTO_REPLIES=Yo, estoy al tanto.,Sí, ya lo sé,Enterado,sin problema

# (Legacy) Respuesta única
# AUTO_REPLY=Yo, estoy al tanto.

# Ruta de Chrome (por defecto: Windows local / /usr/bin/chromium en Linux)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Token para proteger el endpoint /qr (opcional)
# QR_TOKEN=mi-token-secreto

# Puerto del web server (Render lo inyecta automáticamente)
# PORT=7860
